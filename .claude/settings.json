{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(!.env.sample)",
      "Edit(!.env.template)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(*.claude/settings.json*)",
      "PowerShell(*.claude/settings.json*)",
      "Bash(*.claude/hooks/*)",
      "PowerShell(*.claude/hooks/*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(printenv *)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content */.env*)",
      "PowerShell(Get-ChildItem Env:*)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv add *)",
      "Bash(cargo add *)",
      "Bash(poetry add *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(pip install *)",
      "PowerShell(pip3 install *)",
      "PowerShell(uv add *)",
      "PowerShell(cargo add *)",
      "PowerShell(poetry add *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(twine upload *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(yarn publish *)",
      "PowerShell(twine upload *)",
      "PowerShell(cargo publish *)",
      "PowerShell(docker push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue close *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh release delete *)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo archive *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(tofu import *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(terraform import *)",
      "PowerShell(tofu apply *)",
      "PowerShell(tofu destroy *)",
      "PowerShell(tofu import *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl set *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "PowerShell(kubectl apply *)",
      "PowerShell(kubectl create *)",
      "PowerShell(kubectl delete *)",
      "PowerShell(kubectl patch *)",
      "PowerShell(kubectl replace *)",
      "PowerShell(kubectl scale *)",
      "PowerShell(kubectl set *)",
      "PowerShell(kubectl rollout restart *)",
      "PowerShell(kubectl rollout undo *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm rollback *)",
      "PowerShell(helm install *)",
      "PowerShell(helm upgrade *)",
      "PowerShell(helm uninstall *)",
      "PowerShell(helm rollback *)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn dlx *)",
      "Bash(uvx *)",
      "Bash(pipx run *)",
      "PowerShell(npx -y *)",
      "PowerShell(npx --yes *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(yarn dlx *)",
      "PowerShell(uvx *)",
      "PowerShell(pipx run *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean -*)",
      "PowerShell(git clean -*)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git stash drop *)",
      "PowerShell(git stash drop *)",
      "Bash(git stash clear)",
      "PowerShell(git stash clear)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(Remove-Item * -Recurse * -Force*)",
      "PowerShell(Set-ExecutionPolicy *)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/change_surface_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/startup_health.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/posttool_scope_audit.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/completion_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
